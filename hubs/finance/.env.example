# Copier en .env (ignoré par git) et renseigner de vraies valeurs avant
# `docker compose up -d --build`. Ne jamais commiter de vrais secrets.

# Mot de passe du rôle Postgres "finance" créé par le conteneur db.
DB_PASSWORD=change-me

# Secret de signature JWT (32+ caractères aléatoires).
JWT_SECRET=change-me-32-chars-minimum

# Mot de passe du compte admin créé au premier démarrage.
ADMIN_PASSWORD=change-me

# Origines autorisées en CORS (liste séparée par des virgules), ex :
# https://finance.example.com
APP_CORS_ALLOWED_ORIGINS=https://localhost

# URL publique du backend (liens générés dans les emails, etc.).
APP_BASE_URL=https://localhost

# Ports exposés sur l'hôte (optionnel, valeurs par défaut ci-dessous).
# BACKEND_PORT=8093
# FRONTEND_PORT=5399
