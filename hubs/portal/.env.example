# Copier en .env (ignoré par git) et renseigner de vraies valeurs avant
# `docker compose up -d --build`. Ne jamais commiter de vrais secrets.

# Mot de passe du rôle Postgres "praxio" créé par le conteneur db.
DB_PASSWORD=change-me

# Mot de passe de l'unique compte admin (Basic Auth, pas de JWT côté Praxio).
ADMIN_PASSWORD=change-me

# Clé de chiffrement AES des mots de passe SSO stockés au repos
# (32+ caractères aléatoires).
SSO_ENCRYPTION_KEY=change-me-32-chars-minimum

# Origines autorisées en CORS (liste séparée par des virgules), ex :
# https://praxio.example.com
# Le frontend sert /api/ via un proxy nginx sur le même port publié (5180) --
# le défaut ci-dessous doit matcher ce port, pas "https://localhost" (mauvais
# protocole + port manquant) sans quoi le back rejette toute requête en 403
# "Invalid CORS request" (y compris la connexion, avant même de vérifier le
# mot de passe).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5180

# URLs des 4 hubs agrégés (API backend + frontend, pour le relais SSO et le
# tableau de bord cross-hub). Praxio ne les démarre pas lui-même -- il faut
# que chaque hub tourne déjà (son propre docker compose, ou en prod les vraies
# URLs publiques) et soit joignable depuis ce conteneur.
#
# En local avec Docker (Option A) : CE CONTENEUR ne peut pas joindre les
# autres hubs via "localhost" (ça pointerait vers lui-même). Utiliser
# host.docker.internal avec le port publié sur l'hôte par chaque hub
# (celui que tu as mis dans son propre .env si tu l'as changé).
COMPLIANCE_ENGINE_URL=http://host.docker.internal:8081
COMPLIANCE_ENGINE_FRONTEND_URL=http://host.docker.internal:5174
FLEET_HUB_URL=http://host.docker.internal:8090
FLEET_HUB_FRONTEND_URL=http://host.docker.internal:5199
LOGISTIX_URL=http://host.docker.internal:8091
LOGISTIX_FRONTEND_URL=http://host.docker.internal:5181
FINANCE_URL=http://host.docker.internal:8093
FINANCE_FRONTEND_URL=http://host.docker.internal:5399

# Ports exposés sur l'hôte (optionnel, valeurs par défaut ci-dessous).
# BACKEND_PORT=8092
# FRONTEND_PORT=5180
