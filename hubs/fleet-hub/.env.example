# Copier ce fichier vers .env puis compléter les valeurs (production).
# Ne jamais committer .env dans le dépôt.

# --- Déploiement (HTTPS) ---
# Nom de domaine public de l'application. Caddy obtient automatiquement un
# certificat Let's Encrypt pour un domaine réel ; laissez `localhost` pour un
# test local (certificat interne).
# Ex: APP_DOMAIN=fleethub.monentreprise.fr
APP_DOMAIN=localhost

# Environnement exposé à la supervision (Sentry). Production = production.
#APP_ENV=production

# --- Backup PostgreSQL (conteneur `backup`) ---
# Rétention en jours des dumps (défaut: 7). Le dump a lieu au démarrage puis
# toutes les BACKUP_INTERVAL_HOURS heures (défaut: 24). Les fichiers sont dans ./backups/
#BACKUP_KEEP_DAYS=7
#BACKUP_INTERVAL_HOURS=24
# Copie hors site (fortement recommandé : ./backups/ ne survit pas à la perte du VPS).
# RCLONE_REMOTE au format "remote:bucket/chemin" (ex. "s3:mon-bucket/fleethub"), et
# RCLONE_CONFIG_BASE64 = contenu de rclone.conf (généré via `rclone config`) encodé en
# base64 : `base64 -w0 ~/.config/rclone/rclone.conf`.
#RCLONE_REMOTE=s3:mon-bucket/fleethub
#RCLONE_CONFIG_BASE64=
# Ping de supervision après chaque sauvegarde (ex. compte gratuit sur healthchecks.io) :
# alerte si le job de backup s'arrête de tourner silencieusement.
#BACKUP_PING_URL=https://hc-ping.com/votre-uuid

# --- Supervision des erreurs (Sentry, facultatif) ---
# DSN Sentry pour le backend (erreurs serveur). Vide = SDK désactivé.
#SENTRY_DSN=https://xxxxxxx@o000000.ingest.sentry.io/0000000
# DSN Sentry pour le frontend (erreurs navigateur). Même compte Sentry, autre DSN.
#SENTRY_DSN_FRONTEND=https://xxxxxxx@o000000.ingest.sentry.io/0000001
# Ping de supervision uptime après chaque déploiement (ex. healthchecks.io) :
# alerte si le site tombe.
#PING_URL=https://hc-ping.com/votre-uuid

# --- Base de données PostgreSQL ---
# Mot de passe du superutilisateur créé dans le conteneur et utilisé par le backend.
DB_PASSWORD=changer-moi-avec-un-mot-de-passe-long

# --- Authentification API ---
# Clé secrète de signature des JWT. Min 32 caractères, valeur aléatoire (ex: openssl rand -hex 64).
JWT_SECRET=changez-cette-cle-par-une-cle-aleatoire-de-64-octets

# Mots de passe des comptes initialisés au premier démarrage (profil prod).
# ADMIN_PASSWORD sert aussi au compte SAAS_ADMIN (`saasadmin`).
ADMIN_PASSWORD=changer-moi
GESTIONNAIRE_PASSWORD=changer-moi

# Durée de l'essai gratuit des nouvelles sociétés (jours). Défaut: 14.
#APP_REGISTRATION_TRIAL_DAYS=14

# Données de démonstration au premier démarrage (compte `admin`, société démo et
# ~35 jours d'activité). Défaut: false en production. La démo vendable (DEPLOY.md)
# attend true au premier déploiement, puis peut être repassée à false.
#APP_SEED_ENABLED=true

# Délai de grâce après expiration de l'essai avant bascule automatique en SUSPENDED
# (le gel des données est effectif dès l'expiration). Défaut: 7 jours.
#APP_TRIAL_GRACE_DAYS=7

# --- CORS (origines autorisées du frontend, séparées par des virgules) ---
# En prod avec Caddy, le défaut du docker-compose est https://<APP_DOMAIN>.
# Ex: APP_CORS_ALLOWED_ORIGINS=https://app.monentreprise.fr,https://demo.monentreprise.fr
APP_CORS_ALLOWED_ORIGINS=http://localhost:5199

# Limite de tentatives de connexion par minute et par IP (défaut: 10).
#APP_LOGIN_RATE_LIMIT=10

# Rate limiting global (par route).
# APP_RATE_LIMIT_ENABLED : activer/désactiver (défaut: true).
# APP_RATE_LIMIT_DEFAULT : limite par défaut pour les routes non spécifiques (défaut: 60/min).
# Les routes /api/auth/login et /api/auth/register sont limitées à 5/min (hardcodé).
#APP_RATE_LIMIT_ENABLED=true
#APP_RATE_LIMIT_DEFAULT=60

# IP allowlisting pour /api/admin/** (séparées par virgules).
# Vide = pas de restriction (dev/test). En prod, lister les IPs du/des admin(s).
# Ex: APP_ADMIN_ALLOWED_IPS=1.2.3.4,5.6.7.8
#APP_ADMIN_ALLOWED_IPS=

# --- Facturation Stripe (activation) ---
# Passer STRIPE_ENABLED=true pour activer checkout/portail/webhooks.
#STRIPE_ENABLED=false
#STRIPE_SECRET_KEY=sk_live_...
#STRIPE_WEBHOOK_SECRET=whsec_...
#STRIPE_PRICE_STARTER=price_...
#STRIPE_PRICE_PRO=price_...
#STRIPE_PRICE_ENTERPRISE=price_...
# URL publiques (doivent pointer vers le frontend exposé) :
#STRIPE_SUCCESS_URL=https://app.monentreprise.fr/billing
#STRIPE_CANCEL_URL=https://app.monentreprise.fr/billing
#STRIPE_PORTAL_RETURN_URL=https://app.monentreprise.fr/billing

# --- Intégrations externes (page self-service « Intégrations ») ---
# Clé maîtresse de chiffrement des clés API fournisseurs stockées en base.
# (AES-GCM, dérivée par SHA-256 — toute valeur longue aléatoire convient).
INTEGRATION_SECRET_KEY=changer-moi-avec-une-longue-valeur-aleatoire

# Clé partagée du canal de push historique POST /api/webhooks/ingest
# (optionnelle : les clients peuvent aussi utiliser leur clé de webhook
# générée depuis la page « Intégrations »).
#INTEGRATION_WEBHOOK_API_KEY=changer-moi

# --- URL publique de l'application (utilisée dans les emails d'invitation) ---
#APP_BASE_URL=https://app.monentreprise.fr

# --- Emails transactionnels (SMTP) ---
#MAIL_ENABLED=false
#MAIL_HOST=smtp.monentreprise.fr
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_FROM=no-reply@fleethub.fr

# --- Monitoring (Prometheus + Grafana + Loki) ---
# Accès Grafana : https://<APP_DOMAIN>/grafana
#GRAFANA_USER=admin
#GRAFANA_PASSWORD=changer-moi
