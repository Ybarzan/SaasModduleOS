# Variables d'environnement du frontend (lues au build Vite)
# Copier ce fichier en .env.local pour un usage local.

# URL de base de l'API backend pour l'app native (Capacitor).
# Doit inclure le préfixe /api, ex. : https://api.exemple.fr/api
# En dev navigateur, inutile : le proxy Vite (/api -> localhost:8090) prend le relais.
VITE_API_BASE_URL=

# Supervison des erreurs (Sentry). Laisser vide pour désactiver l'envoi.
#VITE_SENTRY_DSN=https://xxxxxxx@o000000.ingest.sentry.io/0000000
#VITE_APP_ENV=production
