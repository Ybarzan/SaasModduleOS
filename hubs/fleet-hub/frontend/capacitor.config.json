{
  "appId": "fr.fleethub.app",
  "appName": "Fleet Hub",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "always"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1800,
      "backgroundColor": "#0b0f16",
      "showSpinner": false,
      "androidScaleType": "centerCrop"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#0b0f16",
      "overlaysWebView": true
    }
  }
}
