# ═══════════════════════════════════════════════════════════════════════
# IncoKalk - Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ⚠️  NE JAMAIS commiter le fichier .env dans git
# ═══════════════════════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_DB=incokalk
POSTGRES_USER=incokalk
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── MinIO (stockage fichiers) ──────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Spring Boot (OBLIGATOIRES) ─────────────────────────────────────
# Générer un secretfort: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
API_KEY_SALT=CHANGE_ME_RANDOM_SALT
EXCHANGERATE_API_KEY=
CORS_ORIGINS=http://localhost:5174,http://localhost:5173

# ── Stripe ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# ── Ports (Docker ≠ dev local 8080/5173) ───────────────────────────
API_PORT=8081
FRONTEND_PORT=5174
HTTP_PORT=80
HTTPS_PORT=443

# ── Backup ──────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30

# ── pgAdmin (dev) ──────────────────────────────────────────────────
PGADMIN_EMAIL=admin@incokalk.io
PGADMIN_PASSWORD=admin
