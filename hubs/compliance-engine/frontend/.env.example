# Frontend Environment Variables

# API Configuration
# Base URL complète de l'API (incluant le préfixe /api).
# Laisser vide pour utiliser le proxy Vite (dev) ou le proxy nginx (Docker),
# qui redirigent /api vers le backend.
VITE_API_URL=

# App Configuration
VITE_APP_NAME=IncoKalk
VITE_APP_VERSION=1.0.0

# Google Analytics 4 — laisser vide pour désactiver (aucun script tiers chargé,
# aucun cookie déposé). Format attendu : G-XXXXXXXXXX (créer une propriété GA4
# sur analytics.google.com > Admin > Créer une propriété).
VITE_GA_MEASUREMENT_ID=
