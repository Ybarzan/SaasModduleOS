# Copier en .env (ignoré par git) et renseigner de vraies valeurs avant
# `docker compose up -d --build`. Ne jamais commiter de vrais secrets.

# Mot de passe du rôle Postgres "logistix" créé par le conteneur db.
DB_PASSWORD=change-me

# Secret de signature JWT (32+ caractères aléatoires).
JWT_SECRET=change-me-32-chars-minimum

# Mot de passe du compte admin créé au premier démarrage.
ADMIN_PASSWORD=change-me

# Clé de chiffrement AES des identifiants (fleetHubApiKey) stockés au repos
# (32+ caractères aléatoires, distincte de JWT_SECRET).
CREDENTIAL_ENCRYPTION_KEY=change-me-32-chars-minimum

# Origines autorisées en CORS (liste séparée par des virgules), ex :
# https://logistix.example.com
# Le frontend sert /v1/ via un proxy nginx sur le même port publié (5181) --
# le défaut ci-dessous doit matcher ce port, pas "https://localhost" (mauvais
# protocole + port manquant) sans quoi le back rejette toute requête en 403
# "Invalid CORS request" (y compris /v1/auth/login, avant même de vérifier
# le mot de passe).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5181

# URL publique du backend (liens générés dans les emails, etc.).
APP_BASE_URL=https://localhost

# Ports exposés sur l'hôte (optionnel, valeurs par défaut ci-dessous).
# BACKEND_PORT=8091
# FRONTEND_PORT=5181
